{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(.venv/Scripts/python -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "P=$(command -v python || command -v python3) && \"$P\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\"",
            "timeout": 120,
            "statusMessage": "시험 실행 중 (python -m pytest)"
          }
        ]
      }
    ]
  }
}
